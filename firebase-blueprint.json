  "firestore": {
    "/engineer_documents/{docId}": {
      "schema": "EngineerDocument",
      "description": "Quotations and LPOs prepared by engineers"
    },
    "/holidays/{holidayId}": {
      "schema": "Holiday",
      "description": "Calendar corporate holidays"
    },
    "/employees/{employeeId}": {
