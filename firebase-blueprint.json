{
  "entities": {
    "Employee": {
      "title": "Employee",
      "description": "Employee profile and employment details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "designation": { "type": "string" },
        "department": { "type": "string" },
        "joiningDate": { "type": "string" },
        "type": { "type": "string", "enum": ["Staff", "Worker"] },
        "company": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "team": { "type": "string", "enum": ["Internal Team", "External Team", "Office Staff"] },
        "workLocation": { "type": "string" },
        "leaveBalance": { "type": "number" },
        "bankName": { "type": "string" },
        "iban": { "type": "string" },
        "salary": {
          "type": "object",
          "properties": {
            "basic": { "type": "number" },
            "housing": { "type": "number" },
            "transport": { "type": "number" },
            "other": { "type": "number" },
            "airTicket": { "type": "number" },
            "leaveSalary": { "type": "number" },
            "hourlyRate": { "type": "number" }
          }
        },
        "active": { "type": "boolean" },
        "offboardingDetails": { "type": "object" },
        "rejoiningDate": { "type": "string" },
        "rejoiningReason": { "type": "string" },
        "documents": { "type": "object" },
        "vacationScheduledDate": { "type": "string" }
      },
      "required": ["id", "code", "name", "company", "active"]
    },
    "AttendanceRecord": {
      "title": "Attendance Record",
      "description": "Daily attendance log for an employee",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "hoursWorked": { "type": "number" },
        "overtimeHours": { "type": "number" },
        "checkInTime": { "type": "string" },
        "checkOutTime": { "type": "string" },
        "otAttachment": { "type": "string" },
        "updatedBy": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["id", "employeeId", "date", "status"]
    },
    "LeaveRequest": {
      "title": "Leave Request",
      "description": "Employee leave application",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "type": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "appliedOn": { "type": "string" },
        "createdBy": { "type": "string" },
        "approvedBy": { "type": "string" }
      },
      "required": ["id", "employeeId", "startDate", "endDate", "status"]
    },
    "DeductionRecord": {
      "title": "Deduction Record",
      "description": "Salary deduction or advance record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "note": { "type": "string" }
      },
      "required": ["id", "employeeId", "date", "amount"]
    },
    "SystemUser": {
      "title": "System User",
      "description": "Application user with specific roles and permissions",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "active": { "type": "boolean" },
        "permissions": { "type": "object" }
      },
      "required": ["uid", "email", "role"]
    },
    "Company": {
      "title": "Company",
      "description": "Company entity name",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "code", "name"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Supplier entity details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "contactPerson": { "type": "string" },
        "address": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "category": { "type": "string" },
        "notes": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "code", "name", "contactPerson"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "System activity and audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "type": { "type": "string", "enum": ["create", "update", "delete", "system"] },
        "isCreator": { "type": "boolean" }
      },
      "required": ["id", "timestamp", "userId", "action"]
    },
    "Project": {
      "title": "Project",
      "description": "Project details and management",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "clientName": { "type": "string" },
        "location": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Completed", "On Hold"] },
        "description": { "type": "string" },
        "estimationValue": { "type": "number" },
        "income": { "type": "number" },
        "overallExpenses": { "type": "number" },
        "assignedStaffCount": { "type": "number" },
        "order": { "type": "number" },
        "driveFolderId": { "type": "string" },
        "driveFiles": { "type": "array" }
      },
      "required": ["id", "code", "name", "status"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Vendor entity details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "contactPerson": { "type": "string" },
        "address": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "category": { "type": "string" },
        "notes": { "type": "string" },
        "logo": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "code", "name", "contactPerson"]
    },
    "AccountsPayable": {
      "title": "Accounts Payable",
      "description": "Outgoing payments and vendor invoices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "vendorId": { "type": "string" },
        "vendorType": { "type": "string", "enum": ["Supplier", "Vendor"] },
        "projectId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Paid", "Partially Paid"] },
        "dueDate": { "type": "string" },
        "paymentDate": { "type": "string" },
        "attachment": { "type": "string" }
      },
      "required": ["id", "date", "vendorId", "vendorType", "invoiceNumber", "amount", "status"]
    },
    "AccountsReceivable": {
      "title": "Accounts Receivable",
      "description": "Incoming payments and client invoices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "projectId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Received", "Partially Received"] },
        "dueDate": { "type": "string" },
        "receivedDate": { "type": "string" },
        "attachment": { "type": "string" }
      },
      "required": ["id", "date", "projectId", "invoiceNumber", "amount", "status"]
    },
    "PettyCash": {
      "title": "Petty Cash",
      "description": "Small daily expenses and cash on hand",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["Income", "Expense"] },
        "requestedBy": { "type": "string" },
        "approvedBy": { "type": "string" },
        "projectId": { "type": "string" },
        "attachment": { "type": "string" }
      },
      "required": ["id", "date", "category", "description", "amount", "type", "requestedBy"]
    },
    "ProjectedExpense": {
      "title": "Projected Expense",
      "description": "Projected expense tracking with VAT",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "siNo": { "type": "string" },
        "date": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "billDescription": { "type": "string" },
        "clientName": { "type": "string" },
        "siteLocation": { "type": "string" },
        "workDescription": { "type": "string" },
        "actualAmount": { "type": "number" },
        "vatAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "projectId": { "type": "string" }
      },
      "required": ["id", "date", "invoiceNumber", "actualAmount", "vatAmount", "totalAmount"]
    }
  },
  "firestore": {
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Collection of employee profiles"
    },
    "/attendance/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Daily attendance records"
    },
    "/leaves/{leaveId}": {
      "schema": "LeaveRequest",
      "description": "Leave requests and approvals"
    },
    "/deductions/{deductionId}": {
      "schema": "DeductionRecord",
      "description": "Salary deductions and advances"
    },
    "/users/{userId}": {
      "schema": "SystemUser",
      "description": "System users and their permissions"
    },
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "List of companies managed in the system"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "List of suppliers managed in the system"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "List of projects managed in the system"
    },
    "/vendors/{vendorId}": {
      "schema": "Vendor",
      "description": "List of vendors managed in the system"
    },
    "/accounts_payable/{apId}": {
      "schema": "AccountsPayable",
      "description": "Accounts payable records"
    },
    "/accounts_receivable/{arId}": {
      "schema": "AccountsReceivable",
      "description": "Accounts receivable records"
    },
    "/petty_cash/{pcId}": {
      "schema": "PettyCash",
      "description": "Petty cash transaction records"
    },
    "/projected_expenses/{peId}": {
      "schema": "ProjectedExpense",
      "description": "Projected expense records"
    },
    "/settings/about": {
      "schema": "object",
      "description": "General application about data"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "System activity logs"
    }
  }
}
