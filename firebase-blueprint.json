    },
    "AccountsPayable": {
      "title": "Accounts Payable",
      "description": "Outgoing payments and vendor invoices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "vendorId": { "type": "string" },
