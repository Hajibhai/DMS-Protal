      "description": "Everyday expense records"
    },
    "/cicpa_records/{recordId}": {
      "schema": "CICPARecord",
      "description": "CICPA application tracking records"
    },
    "/safety_records/{recordId}": {
      "schema": "SafetyRecord",
      "description": "Safety credentials and training certificates for employees"
    },
    "/settings/about": {
      "schema": "object",
      "description": "General application about data"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "System activity logs"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Collaborative tasks for team workflows"
    },
    "/notes/{noteId}": {
      "schema": "Note",
      "description": "Collaborative memorandum board sticky notes"
    },
    "/bank_accounts/{accountId}": {
      "schema": "CorporateBankAccount",
      "description": "Corporate bank accounts configuration"
    }
  }
