rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Creator')) ||
         (request.auth.token.email == "abdulkaderp3010@gmail.com"));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCreator() {
      return isAuthenticated() && 
        (request.auth.token.email == "abdulkaderp3010@gmail.com");
    }

    function hasPermission(permission) {
      return isAuthenticated() && 
        (isCreator() || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions[permission] == true));
    }

    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && (
        isCreator() || 
        (hasPermission('canManageSettings') || hasPermission('canManageUsers') || hasPermission('canManageEmployees'))
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || hasPermission('canManageUsers');
      allow create: if isAuthenticated() && (isOwner(userId) || hasPermission('canManageUsers'));
      allow update: if isAuthenticated() && (isOwner(userId) || hasPermission('canManageUsers'));
      allow delete: if hasPermission('canManageUsers');
    }

    match /employees/{employeeId} {
      allow read: if hasPermission('canViewDirectory') || hasPermission('canManageEmployees');
      allow write: if hasPermission('canManageEmployees');
    }

    match /attendance/{recordId} {
      allow read: if hasPermission('canViewTimesheet') || hasPermission('canManageAttendance');
      allow write: if hasPermission('canManageAttendance');
    }

    match /leaves/{leaveId} {
      allow read: if hasPermission('canManageLeaves');
      allow write: if hasPermission('canManageLeaves') || isAuthenticated();
    }

    match /deductions/{deductionId} {
      allow read: if hasPermission('canViewPayroll') || hasPermission('canManagePayroll');
      allow write: if hasPermission('canManagePayroll');
    }

// Validate Company
function isValidCompany(data) {
  return data.keys().hasAll(['id', 'code', 'name']) &&
         data.id is string &&
         data.code is string && data.code.size() >= 1 && data.code.size() <= 50 &&
         data.name is string && data.name.size() >= 2 && data.name.size() <= 200 &&
         (!('address' in data) || data.address is string) &&
         (!('email' in data) || data.email is string) &&
         (!('phone' in data) || data.phone is string) &&
         (!('logo' in data) || data.logo is string) &&
         (!('order' in data) || data.order is number);
}

// Validate Supplier
function isValidSupplier(data) {
  return data.keys().hasAll(['id', 'code', 'name', 'contactPerson']) &&
         data.id is string &&
         data.code is string && data.code.size() >= 1 && data.code.size() <= 50 &&
         data.name is string && data.name.size() >= 2 && data.name.size() <= 200 &&
         data.contactPerson is string &&
         (!('address' in data) || data.address is string) &&
         (!('email' in data) || data.email is string) &&
         (!('phone' in data) || data.phone is string) &&
         (!('category' in data) || data.category is string) &&
         (!('notes' in data) || data.notes is string) &&
         (!('logo' in data) || data.logo is string) &&
         (!('order' in data) || data.order is number);
}

// Validate Project
function isValidProject(data) {
  return data.keys().hasAll(['id', 'code', 'name', 'status']) &&
         data.id is string &&
         data.code is string && data.code.size() >= 1 && data.code.size() <= 50 &&
         data.name is string && data.name.size() >= 2 && data.name.size() <= 200 &&
         data.status in ['Active', 'Completed', 'On Hold'] &&
         (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 200)) &&
         (!('location' in data) || (data.location is string && data.location.size() <= 500)) &&
         (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 50)) &&
         (!('endDate' in data) || (data.endDate is string && data.endDate.size() <= 50)) &&
         (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
         (!('estimationValue' in data) || data.estimationValue is number) &&
         (!('income' in data) || data.income is number) &&
         (!('overallExpenses' in data) || data.overallExpenses is number) &&
         (!('order' in data) || data.order is number) &&
         (!('driveFolderId' in data) || (data.driveFolderId is string && data.driveFolderId.size() <= 100)) &&
         (!('driveFiles' in data) || (data.driveFiles is list && data.driveFiles.size() <= 50));
}

match /companies/{companyId} {
  allow read: if isAuthenticated();
  allow create: if hasPermission('canManageSettings') && isValidCompany(request.resource.data);
  allow update: if hasPermission('canManageSettings') && isValidCompany(request.resource.data);
  allow delete: if hasPermission('canManageSettings');
}

match /suppliers/{supplierId} {
  allow read: if isAuthenticated();
  allow create: if hasPermission('canManageSuppliers') && isValidSupplier(request.resource.data);
  allow update: if hasPermission('canManageSuppliers') && isValidSupplier(request.resource.data);
  allow delete: if hasPermission('canManageSuppliers');
}

match /projects/{projectId} {
  allow read: if isAuthenticated();
  allow create: if hasPermission('canManageProjects') && isValidProject(request.resource.data);
  allow update: if hasPermission('canManageProjects') && isValidProject(request.resource.data);
  allow delete: if hasPermission('canManageProjects');
}

    match /settings/about {
      allow read: if true;
      allow write: if hasPermission('canManageSettings');
    }
  }
}
