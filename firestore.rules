rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Creator' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CREATOR' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'creator')) ||
         (request.auth.token.email == "abdulkaderp3010@gmail.com"));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCreator() {
      return isAuthenticated() && 
        (request.auth.token.email == "abdulkaderp3010@gmail.com");
    }

    function hasPermission(permission) {
      return isAuthenticated() && 
        (isCreator() || 
         isAdmin() ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions[permission] == true));
    }

    // Finance & Vendor Rules
    match /vendors/{vendorId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /accounts_payable/{apId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManagePayroll');
    }

    match /accounts_receivable/{arId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManagePayroll');
    }

    match /petty_cash/{pcId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManagePayroll');
    }

    match /projected_expenses/{peId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManagePayroll');
    }

    match /camps/{campId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManagePayroll') || hasPermission('canManageFinance');
    }

    match /everyday_expenses/{eeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if hasPermission('canManagePayroll') || 
                            (isAuthenticated() && (
                              resource.data.uploadedByUid == request.auth.uid || 
                              resource.data.uploadedByUid == null || 
                              resource.data.uploadedByUid == ""
                            ));
    }

    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && (
        isCreator() || 
        (hasPermission('canManageSettings') || hasPermission('canManageUsers') || hasPermission('canManageEmployees'))
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isOwner(userId) || 
        isCreator() || 
        isAdmin() || 
        hasPermission('canManageUsers')
      );
    }

    match /employees/{employeeId} {
      allow read: if hasPermission('canViewDirectory') || 
                   hasPermission('canManageEmployees') || 
                   (isAuthenticated() && (
                     employeeId == request.auth.uid || 
                     (resource != null && (
                       resource.data.userId == request.auth.uid ||
                       resource.data.id == request.auth.uid ||
                       resource.data.name == request.auth.token.name
                     ))
                   ));
      allow write: if hasPermission('canManageEmployees');
    }

    match /attendance/{recordId} {
      allow read: if hasPermission('canViewTimesheet') || hasPermission('canManageAttendance');
      allow write: if hasPermission('canManageAttendance');
    }

    match /leaves/{leaveId} {
      allow read: if hasPermission('canManageLeaves');
      allow write: if hasPermission('canManageLeaves') || isAuthenticated();
    }

    match /deductions/{deductionId} {
      allow read: if hasPermission('canViewPayroll') || hasPermission('canManagePayroll');
      allow write: if hasPermission('canManagePayroll');
    }

    match /cicpa_records/{recordId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManageEmployees');
    }

    match /safety_records/{recordId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManageEmployees');
    }

    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManageSettings');
    }

    match /suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManageSuppliers');
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManageProjects');
    }

    match /settings/about {
      allow read: if true;
      allow write: if hasPermission('canManageSettings');
    }

    match /holidays/{holidayId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManageSettings');
    }

    match /job_applicants/{docId} {
      allow read, write: if hasPermission('canManageEmployees');
    }

    match /job_offers/{docId} {
      allow read, write: if hasPermission('canManageEmployees');
    }

    match /job_offers/{docId}/chunks/{chunkId} {
      allow read, write: if isAuthenticated();
    }

    match /engineer_documents/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    match /notes/{noteId} {
      allow read, write: if isAuthenticated();
    }

    match /meetings/{meetingId} {
      allow read, write: if isAuthenticated();
    }

    match /bank_accounts/{accountId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManageSettings') || isAdmin();
    }

    match /report_schedules/{scheduleId} {
      allow read, write: if isAuthenticated();
    }

    match /report_transactions/{transactionId} {
      allow read, write: if true;
    }
  }
}
