rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Creator')) ||
         (request.auth.token.email == "abdulkaderp3010@gmail.com"));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCreator() {
      return isAuthenticated() && 
        (request.auth.token.email == "abdulkaderp3010@gmail.com");
    }

    function hasPermission(permission) {
      return isAuthenticated() && 
        (isCreator() || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions[permission] == true));
    }

    // Finance & Vendor Rules
    match /vendors/{vendorId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManageProjects');
    }

    match /accounts_payable/{apId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManagePayroll');
    }

    match /accounts_receivable/{arId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManagePayroll');
    }

    match /petty_cash/{pcId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManagePayroll');
    }

    match /projected_expenses/{peId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManagePayroll');
    }

    match /everyday_expenses/{eeId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManagePayroll');
    }

    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && (
        isCreator() || 
        (hasPermission('canManageSettings') || hasPermission('canManageUsers') || hasPermission('canManageEmployees'))
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || hasPermission('canManageUsers');
      allow create: if isAuthenticated() && (isOwner(userId) || hasPermission('canManageUsers'));
      allow update: if isAuthenticated() && (isOwner(userId) || hasPermission('canManageUsers'));
      allow delete: if hasPermission('canManageUsers');
    }

    match /employees/{employeeId} {
      allow read: if hasPermission('canViewDirectory') || hasPermission('canManageEmployees');
      allow write: if hasPermission('canManageEmployees');
    }

    match /attendance/{recordId} {
      allow read: if hasPermission('canViewTimesheet') || hasPermission('canManageAttendance');
      allow write: if hasPermission('canManageAttendance');
    }

    match /leaves/{leaveId} {
      allow read: if hasPermission('canManageLeaves');
      allow write: if hasPermission('canManageLeaves') || isAuthenticated();
    }

    match /deductions/{deductionId} {
      allow read: if hasPermission('canViewPayroll') || hasPermission('canManagePayroll');
      allow write: if hasPermission('canManagePayroll');
    }

    match /cicpa_records/{recordId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManageEmployees');
    }

    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManageSettings');
    }

    match /suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManageSuppliers');
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManageProjects');
    }

    match /settings/about {
      allow read: if true;
      allow write: if hasPermission('canManageSettings');
    }
  }
}
